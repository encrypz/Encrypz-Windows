<Window x:Class="Encrypz.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Encrypz" Height="820" Width="1240" MinHeight="600" MinWidth="900"
        Background="#0A0A0A" Foreground="#F4F4F5" FontFamily="Segoe UI"
        Icon="pack://application:,,,/logo.png" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#141414" BorderBrush="#292929" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SettingsButton" Content="Connection settings" Click="Settings_Click" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="Open logs" Click="Logs_Click" Padding="12,4" />
                </StackPanel>
                <TextBlock x:Name="StatusLabel" Text="Starting Encrypz" VerticalAlignment="Center" Foreground="#A1A1AA" />
            </DockPanel>
        </Border>
        <Grid>
            <wv2:WebView2 Name="webView" Visibility="Hidden" />
            <Border x:Name="StartupPanel" Background="#0A0A0A" Padding="48">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="E N C R Y P Z" Foreground="#60A5FA" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,32" />
                    <TextBlock x:Name="StartupTitle" Text="Opening your workspace" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16" />
                    <TextBlock x:Name="StartupDetail" Text="Starting the local service…" FontSize="16" Foreground="#A1A1AA" TextWrapping="Wrap" LineHeight="25" />
                    <ProgressBar x:Name="StartupProgress" IsIndeterminate="True" Height="3" Margin="0,28,0,24" Foreground="#3B82F6" />
                    <Button x:Name="RetryButton" Content="Try again" Click="Retry_Click" Visibility="Collapsed" HorizontalAlignment="Left" Padding="24,12" Margin="0,24,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
