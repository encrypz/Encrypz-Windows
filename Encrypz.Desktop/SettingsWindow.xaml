<Window x:Class="Encrypz.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Encrypz connection settings" Width="640" Height="680" MinWidth="540" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="#111111" Foreground="#F4F4F5" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10" /><Setter Property="Margin" Value="0,6,0,18" />
            <Setter Property="Background" Value="#202020" /><Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="BorderBrush" Value="#52525B" /><Setter Property="CaretBrush" Value="White" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="10" /><Setter Property="Margin" Value="0,6,0,18" />
            <Setter Property="Background" Value="#202020" /><Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="BorderBrush" Value="#52525B" /><Setter Property="CaretBrush" Value="White" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="32">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="ErrorLabel" Foreground="#FCA5A5" Margin="0,12" AutomationProperties.LiveSetting="Assertive" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TestButton" Content="Test database" Click="Test_Click" Padding="16,10" Margin="0,0,12,0" />
                <Button Content="Cancel" IsCancel="True" Padding="20,10" Margin="0,0,12,0" />
                <Button x:Name="SaveButton" Content="Save settings" IsDefault="True" Click="Save_Click" Padding="20,10" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Connect your workspace" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock Text="Encrypz uses MySQL for vault metadata and Google Drive for encrypted files. Enter your service configuration below." Foreground="#A1A1AA" Margin="0,0,0,24" />
                <Label Target="{Binding ElementName=ConnectionInput}" Foreground="#F4F4F5" Content="MySQL connection string" Padding="0" />
                <PasswordBox x:Name="ConnectionInput" AutomationProperties.Name="MySQL connection string" />
                <TextBlock Text="Example: Server=localhost;Database=Encrypz;User=vault;Password=…;SslMode=Required" Foreground="#A1A1AA" FontSize="12" Margin="0,-10,0,18" />
                <Label Target="{Binding ElementName=ClientIdInput}" Foreground="#F4F4F5" Content="Google OAuth client ID" Padding="0" />
                <TextBox x:Name="ClientIdInput" />
                <Label Target="{Binding ElementName=ClientSecretInput}" Foreground="#F4F4F5" Content="Google OAuth client secret" Padding="0" />
                <PasswordBox x:Name="ClientSecretInput" AutomationProperties.Name="Google OAuth client secret" />
                <TextBlock Text="Google OAuth callback URL" />
                <TextBox Text="http://localhost:5207/api/Auth/google-callback" IsReadOnly="True" />
                <TextBlock Text="Register this callback URL in your Google OAuth configuration. Settings are stored in your Windows user profile; environment variables take precedence. Restart the app after changing settings while a vault is open." Foreground="#A1A1AA" FontSize="12" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
